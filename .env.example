# RPC endpoint used by ethers.js to talk to the chain
VITE_RPC_URL=

# Chain ID the app expects the wallet to be connected to
VITE_CHAIN_ID=

# Domain used for SIWE message construction
VITE_APP_DOMAIN=localhost

# Base URL of the nodecrypt-backend auth API
VITE_API_URL=http://localhost:3000

# Contract address
VITE_PROFILE_REGISTRY_ADDRESS=0x000

# FileRegistry and StorageTier — must be the instances the backend reads
VITE_FILE_REGISTRY_ADDRESS=0x000
VITE_STORAGE_TIER_ADDRESS=0x000

# IPFS gateways, comma-separated, tried in order (content is fetched from <url>/ipfs/<cid>)
VITE_IPFS_GATEWAY_URL=https://ipfs.filebase.io,https://gateway.pinata.cloud,https://ipfs.io
